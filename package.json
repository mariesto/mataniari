{
  "name": "ghostty-theme-changer",
  "productName": "Ghostty Theme Changer",
  "version": "0.2.0",
  "private": true,
  "description": "Local web app to browse, edit, and live-preview Ghostty themes — no restart, no Electron",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c cyan,magenta \"vite\" \"GTC_DEV=1 node server/index.cjs\"",
    "build": "vite build",
    "start": "node server/index.cjs",
    "app": "vite build && node server/index.cjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.4",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@fastify/static": "^8.0.3",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/rubik": "^5.1.0",
    "fastify": "^5.2.0",
    "framer-motion": "^11.11.17",
    "open": "^10.1.0",
    "react": "18.3.1",
    "react-colorful": "^5.6.1",
    "react-dom": "18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.3"
  }
}
